{
  "name": "herdown",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev:worker": "pnpm --filter @herdown/worker dev",
    "dev:web": "pnpm --filter @herdown/web dev",
    "dev:cli": "pnpm --filter @herdown/cli dev",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "typescript": "^5.9.2"
  }
}
