{
  "name": "@herdown/cli",
  "version": "0.2.6",
  "description": "Convert any webpage to clean Markdown for AI agents — Herdown CLI",
  "license": "MIT",
  "homepage": "https://herdown.com/cli",
  "repository": {
    "type": "git",
    "url": "https://github.com/less1001/herdown.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/less1001/herdown/issues"
  },
  "keywords": ["markdown", "web-to-markdown", "ai-agents", "cli", "web-extraction"],
  "bin": {
    "herdown": "dist/index.js"
  },
  "type": "module",
  "files": [
    "dist/index.js"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --banner:js='#!/usr/bin/env node'"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
