{
  "manifest_version": 3,
  "name": "Herdown - 网页转 Markdown 剪藏 (Obsidian 专属)",
  "version": "1.0.0",
  "description": "一键将微信公众号、知乎、小红书、36氪及全网网页一键转换为洁净 Markdown，支持 Obsidian 动态标签直连与防爬免封下载。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+H",
        "mac": "Alt+Shift+H"
      },
      "description": "打开 Herdown 剪藏弹窗"
    }
  }
}
